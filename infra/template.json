    "Workflow": {
      "Type": "AWS::StepFunctions::StateMachine",
      "Properties": {
        "StateMachineName": {
          "Fn::Sub": "${AWS::StackName}-deadlines"
        },
        "StateMachineType": "STANDARD",
        "RoleArn": {
          "Fn::GetAtt": [
            "WorkflowRole",
            "Arn"
          ]
        },
        "Definition": {
          "Comment": "Versioned deadline wait; authoritative state checked at execution",
          "StartAt": "WaitForDeadline",
          "States": {
            "WaitForDeadline": {
              "Type": "Wait",
              "TimestampPath": "$.deadline",
              "Next": "CheckCurrentAssignment"
            },
            "CheckCurrentAssignment": {
              "Type": "Task",
              "Resource": {
                "Fn::GetAtt": [
                  "Timer",
                  "Arn"
                ]
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "States.TaskFailed"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2
                }
              ],
              "End": true
            }
          }
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "ShiftFix maintenance prototype",
          "must": "Private data; role-authorized access; no always-running compute"
        }
      }
    },
