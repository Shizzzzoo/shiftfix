        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 12,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true
          }
        },
        "Schema": [
          {
            "Name": "email",
            "Required": true,
            "Mutable": true
          },
          {
            "Name": "name",
            "Required": true,
            "Mutable": true
          }
        ],
        "LambdaConfig": {
          "PostConfirmation": {
            "Fn::GetAtt": [
              "Auth",
              "Arn"
            ]
          }
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
